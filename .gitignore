## Ignore Visual Studio temporary files, build results, and
## files generated by popular extensions.

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# User-specific files
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet
*.nupkg
*.snupkg
*.nuspec
project.lock.json
artifacts/

# Azure Functions local settings file
local.settings.json

# IIS
iisexpress/
*.vspscc
*.vsp

# Rider / JetBrains
.idea/
*.iml

# Visual Studio Code
.vscode/
.history/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# DotCover
*.dotCover

# Dotnet generated files
*.dbmdl
*.bak
*.ldf
*.mdf
*.ndf

# Logs
*.log
*.tlog

# Other
[Tt]est[Rr]esult*/
[Dd]ebugPS/
.publish/
Generated\ Files/

# Publish outputs
*.Publish.xml
publish/

# Docker
*.pid
docker-compose.override.yml

# Environment files
.env
.env.*

# SQLite
*.db

# OS generated
.DS_Store
Thumbs.db


# Others
*.pfx
